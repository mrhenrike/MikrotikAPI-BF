#!/usr/bin/env python3
"""commit-msg hook: strip tool/AI Co-authored-by trailers from commit messages.

Author: Andre Henrique (@mrhenrike) | Uniao Geek
"""
import re
import sys
from pathlib import Path

msg_file = Path(sys.argv[1])
original = msg_file.read_text(encoding="utf-8", errors="replace")

cleaned_lines = [
    line for line in original.splitlines()
    if not re.search(
        r'^\s*Co-authored-by:\s*.*(cursor|cursoragent|copilot|chatgpt|claude|gemini|\bAI\b|LLM|assistant)',
        line,
        re.I,
    )
    and not re.search(r'^\s*Made-with:\s*.*cursor', line, re.I)
    and not re.search(r'^\s*Generated with Cursor', line, re.I)
]

while cleaned_lines and cleaned_lines[-1].strip() == "":
    cleaned_lines.pop()

cleaned = "\n".join(cleaned_lines) + "\n"
if cleaned != original:
    msg_file.write_text(cleaned, encoding="utf-8")
sys.exit(0)